{
  "name": "wayfarer-game",
  "version": "1.0.0",
  "description": "Wayfarer: an exploration and settlement-building game",
  "main": "main.js",
  "author": "Wayfarer",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test test/*.test.cjs",
    "web:build": "node scripts/build-web.cjs",
    "android:sync": "npm run web:build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.56.1"
  },
  "build": {
    "appId": "com.wayfarer.game",
    "productName": "Wayfarer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "wayfarer.html",
      "gfx.js",
      "settlement.js",
      "touch.js",
      "assets/**/*",
      "icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "Wayfarer-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wayfarer"
    }
  },
  "private": true
}
